{
    "ci": {
        "collect": {
            "startServerCommand": "npm run preview -- --port 4173 --strictPort",
            "startServerReadyPattern": "Local",
            "url": [
                "http://localhost:4173/",
                "http://localhost:4173/nft/emerald-ape-042"
            ],
            "numberOfRuns": 3,
            "settings": {
                "chromeFlags": "--headless=new --no-sandbox"
            }
        },
        "upload": {
            "target": "filesystem",
            "outputDir": "lighthouse/reports/mobile"
        }
    }
}